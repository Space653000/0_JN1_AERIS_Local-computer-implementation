{
  "schema_version": 4,
  "contract_id": "AERIS-LOCAL-AUTOPILOT-V4",
  "canonical_core_sha": "5ee7c77869ce2e467f210c6a59bd9030876a4912",
  "trigger": {
    "required_urls": [
      "https://github.com/Space653000/0_JN1_AERIS",
      "https://github.com/Space653000/0_JN1_AERIS_Local-computer-implementation"
    ],
    "two_urls_are_sufficient_when_target_path_is_unambiguous_in_codex": true,
    "target_path_resolution_order": [
      "human_selected_or_opened_codex_path",
      "single_unambiguous_active_writable_workspace_root",
      "explicit_local_target_path_if_supplied"
    ],
    "ask_for_target_path_only_if_unresolved_or_ambiguous": true,
    "embedded_instruction": "Run AERIS_AUTOPILOT automatically using latest CI-passed main; detect/inventory/install/configure/test/accept/open Dashboard/frontend/backend; register OS-native persistence and watchdog; preserve Evidence/Audit; do not use Codex scheduler or launch Claude by default; ask Human only at genuine Human Gates; never fake blocked/unimplemented capabilities."
  },
  "default_mode": "auto",
  "default_local_model": "qwen3:4b-instruct",
  "entrypoints": {
    "windows": "AERIS_AUTOPILOT.ps1",
    "linux_jetson": "AERIS_AUTOPILOT.sh",
    "optional_reviewer_windows": "CLAUDE_VERIFY_AERIS.ps1",
    "optional_reviewer_linux_jetson": "CLAUDE_VERIFY_AERIS.sh"
  },
  "default_execution_policy": {
    "use_codex_tasks_or_scheduler": false,
    "launch_claude_code": false,
    "launch_second_model_reviewer": false,
    "local_acceptance_cycles": 1,
    "ask_human_only_at_human_gate": true
  },
  "phases": [
    "SAFE_PREFLIGHT",
    "MACHINE_INVENTORY",
    "CORE_ALIGNMENT",
    "INSTALL_CONFIGURE",
    "DETERMINISTIC_TESTS",
    "REAL_MACHINE_ACCEPTANCE",
    "COMPANY_OPENING",
    "LOCAL_SUPERVISOR",
    "UNATTENDED_OPERATIONS",
    "EVIDENCE_HANDOFF"
  ],
  "reports": {
    "preflight": ".aeris/state/AUTOPILOT_PREFLIGHT.json",
    "bootstrap": ".aeris/state/AUTOPILOT_RESULT.json",
    "deployment": ".aeris/state/DEPLOYMENT_REPORT.json",
    "acceptance": ".aeris/state/LOCAL_ACCEPTANCE.json",
    "opening": ".aeris/state/COMPANY_OPENING.json",
    "heartbeat": ".aeris/state/HEARTBEAT.json",
    "unattended_install": ".aeris/state/UNATTENDED_INSTALL.json",
    "unattended_runtime": ".aeris/state/UNATTENDED_OPERATIONS.json",
    "audit_ledger": ".aeris/audit/audit.jsonl"
  },
  "supervisor": {
    "bind_host": "127.0.0.1",
    "port": 8765,
    "health_path": "/health",
    "status_path": "/status",
    "heartbeat_interval_sec": 30,
    "watchdog_interval_sec": 20,
    "public_bind_forbidden": true
  },
  "automatic_actions": {
    "inventory": true,
    "create_isolated_state": true,
    "install_supported_redistributable_dependencies": true,
    "sync_and_verify_read_only_core": true,
    "configure_local_model": true,
    "build_local_knowledge": true,
    "run_unit_security_tests": true,
    "run_local_acceptance_if_runtime_available": true,
    "initialize_p0_trust_primitives": true,
    "open_company_to_evidence_supported_scope": true,
    "start_loopback_supervisor": true,
    "register_unattended_user_session_persistence": true,
    "self_heal_loopback_supervisor": true
  },
  "persistence_truth": {
    "codex_scheduler": "NOT_USED",
    "windows_default": "current-user Scheduled Task at logon with restart policy; Startup fallback if policy blocks ScheduledTasks",
    "linux_default": "systemd user service with Restart=always; crontab reboot wrapper fallback",
    "prelogin_system_service": "NOT_CLAIMED_BY_DEFAULT"
  },
  "safety": {
    "destructive_workspace_reinitialization": false,
    "delete_private_data_to_repair": false,
    "auto_accept_core_drift": false,
    "auto_accept_license_or_eula": false,
    "auto_invent_credentials": false,
    "auto_weaken_privacy": false,
    "auto_ignore_failed_test": false,
    "auto_publish_external_release": false,
    "auto_modify_unrelated_firewall": false,
    "watchdog_bypass_opening_or_human_gate": false
  },
  "human_gates": [
    "NO_SAFE_OR_UNAMBIGUOUS_LOCAL_TARGET",
    "ADMIN_OR_OS_POLICY_DENIES_REQUIRED_PERSISTENCE",
    "HEADLESS_PRELOGIN_SERVICE_REQUIRED_BUT_USER_SERVICE_IS_INSUFFICIENT",
    "LICENSE_OR_EULA_REQUIRED",
    "SECRET_OR_HARDWARE_TOKEN_REQUIRED",
    "PHYSICAL_FIXTURE_OR_CALIBRATION_REQUIRED",
    "UNRELATED_DESTRUCTIVE_NETWORK_OR_STORAGE_CHANGE_REQUIRED",
    "CORE_POLICY_CHANGE_REQUIRED",
    "ONE_TIME_REBOOT_OR_LOGOFF_REQUIRED_FOR_PERSISTENCE_ACCEPTANCE",
    "PRODUCTION_CUSTOMER_FORMAL_RELEASE"
  ],
  "opening_states": ["CLOSED", "BOOTSTRAPPING", "BLOCKED", "OPEN_WITH_LIMITS", "OPEN_VERIFIED_SCOPE"],
  "truth_rule": "Autopilot completion means the supported local control plane was deployed, accepted, opened and persistence was registered for its verified scope; it never means all AERIS acoustic capabilities, proprietary tools or formal release gates are complete."
}
