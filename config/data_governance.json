{
  "schema_version": 1,
  "policy_id": "AERIS-DATA-SOVEREIGNTY-v1",
  "default_classification": "LOCAL_ONLY",
  "local_data_egress": "DENY",
  "cloud_usage": "PUBLIC_RESEARCH_INGRESS_ONLY",
  "cloud_request_may_attach": {"local_files": false, "memory": false, "evidence": false, "customer_data": false, "measurement_data": false, "private_prompts": false},
  "cloud_ingress": {"public_query": true, "public_url_download": true, "save_response_locally": true, "save_manifest_and_hash": true},
  "local_stores": [".aeris/knowledge", ".aeris/ingress", ".aeris/state", "data", "logs"],
  "forbidden": ["automatic_upload_of_local_context", "automatic_cloud_embedding_of_local_corpus", "cloud_sync_of_memory_or_evidence", "telemetry_containing_private_payloads"]
}
