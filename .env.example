# AERIS runtime mode: offline | local | cloud | auto
AERIS_AI_MODE=auto

# Local AI (default Ollama-compatible endpoint)
AERIS_LOCAL_BASE_URL=http://127.0.0.1:11434
AERIS_LOCAL_MODEL=qwen2.5:3b
AERIS_LOCAL_TIMEOUT_SEC=120

# Cloud AI (OpenAI-compatible HTTPS endpoint)
AERIS_CLOUD_BASE_URL=https://api.openai.com/v1
AERIS_CLOUD_MODEL=
AERIS_CLOUD_API_KEY=
AERIS_CLOUD_TIMEOUT_SEC=120

# If cloud mode fails, use local provider when possible
AERIS_CLOUD_FALLBACK_TO_LOCAL=true

# Optional behavior
AERIS_SYSTEM_PROMPT=You are AERIS, an evidence-first acoustic engineering runtime.
