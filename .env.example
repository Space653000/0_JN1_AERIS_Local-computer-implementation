# AERIS runtime mode: offline | local | cloud | auto
AERIS_AI_MODE=auto

# Local/private AI. Private engineering chat always uses this boundary.
AERIS_LOCAL_BASE_URL=http://127.0.0.1:11434
AERIS_LOCAL_MODEL=qwen3:4b-instruct
AERIS_LOCAL_TIMEOUT_SEC=120

# Cloud AI is PUBLIC-RESEARCH-ONLY. AERIS does not attach local files, memory, evidence or customer data.
AERIS_CLOUD_BASE_URL=https://api.openai.com/v1
AERIS_CLOUD_MODEL=
AERIS_CLOUD_TIMEOUT_SEC=120

# Prefer one of these at runtime; do NOT commit a real key.
# 1) process environment: AERIS_CLOUD_API_KEY=<secret>
# 2) local secret file outside Git/sync folders:
AERIS_CLOUD_API_KEY_FILE=
# Legacy direct value remains supported for local compatibility but should stay blank here:
AERIS_CLOUD_API_KEY=

# Used only for public research routing, never for private local-context chat.
AERIS_CLOUD_FALLBACK_TO_LOCAL=true

AERIS_SYSTEM_PROMPT=You are AERIS, an evidence-first acoustic engineering runtime. Protect local data sovereignty and never present inference as measured fact.
