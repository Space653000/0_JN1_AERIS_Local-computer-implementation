{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["skill_id", "version", "result", "values", "input_sha256", "implementation_sha256"],
  "properties": {
    "skill_id": {"const": "measurement-difference-significance-baseline"},
    "version": {"type": "string"},
    "result": {"const": "PASS"},
    "input_sha256": {"type": "string"},
    "implementation_sha256": {"type": "string"},
    "values": {
      "type": "object",
      "required": [
        "difference", "combined_standard_error", "z_score", "statistically_significant", "checks", "disposition",
        "required_revisions", "counter_hypotheses", "next_discriminating_experiment", "model_assumptions", "unresolved"
      ],
      "properties": {
        "difference": {"type": "number"},
        "combined_standard_error": {"type": "number"},
        "z_score": {"type": "number"},
        "statistically_significant": {"type": "boolean"},
        "checks": {"type": "array"},
        "disposition": {"type": "string"},
        "required_revisions": {"type": "array"},
        "counter_hypotheses": {"type": "array"},
        "next_discriminating_experiment": {"type": "string"},
        "model_assumptions": {"type": "array"},
        "unresolved": {"type": "array"}
      }
    }
  }
}
