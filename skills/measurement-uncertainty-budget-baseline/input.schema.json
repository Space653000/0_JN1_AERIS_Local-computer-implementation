{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["uncertainty_components", "coverage_factor", "maximum_acceptable_expanded_uncertainty"],
  "properties": {
    "uncertainty_components": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
    },
    "coverage_factor": {"type": "number", "minimum": 1, "maximum": 3},
    "maximum_acceptable_expanded_uncertainty": {"type": "number", "exclusiveMinimum": 0, "maximum": 5000}
  }
}
