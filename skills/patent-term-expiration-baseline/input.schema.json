{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["filing_date_iso", "term_years", "claimed_expiration_date_iso"],
  "properties": {
    "filing_date_iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "term_years": {"type": "integer", "minimum": 1, "maximum": 30},
    "claimed_expiration_date_iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
