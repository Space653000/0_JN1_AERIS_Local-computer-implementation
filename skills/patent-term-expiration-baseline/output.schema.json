{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["skill_id", "version", "result", "values", "input_sha256", "implementation_sha256"],
  "properties": {
    "skill_id": {"const": "patent-term-expiration-baseline"},
    "version": {"type": "string"},
    "result": {"const": "PASS"},
    "input_sha256": {"type": "string"},
    "implementation_sha256": {"type": "string"},
    "values": {
      "type": "object",
      "required": [
        "baseline_expiration_date_iso", "difference_days", "matches_baseline", "checks", "disposition",
        "required_revisions", "counter_hypotheses", "next_discriminating_experiment", "model_assumptions", "unresolved"
      ],
      "properties": {
        "baseline_expiration_date_iso": {"type": "string"},
        "difference_days": {"type": "integer"},
        "matches_baseline": {"type": "boolean"},
        "checks": {"type": "array"},
        "disposition": {"type": "string"},
        "required_revisions": {"type": "array"},
        "counter_hypotheses": {"type": "array"},
        "next_discriminating_experiment": {"type": "string"},
        "model_assumptions": {"type": "array"},
        "unresolved": {"type": "array"}
      }
    }
  }
}
