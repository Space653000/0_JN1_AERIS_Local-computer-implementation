{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configuration",
    "requirements",
    "tests",
    "results",
    "links"
  ],
  "properties": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "revision"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "measurand",
          "unit",
          "reference",
          "lower",
          "upper",
          "combination",
          "required_tests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "measurand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "lower": {
            "type": "number",
            "minimum": -1000000000000,
            "maximum": 1000000000000
          },
          "upper": {
            "type": "number",
            "minimum": -1000000000000,
            "maximum": 1000000000000
          },
          "combination": {
            "const": "ALL"
          },
          "required_tests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "measurand",
          "unit",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "measurand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "payload",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test_id",
              "test_revision",
              "configuration",
              "measurand",
              "unit",
              "reference",
              "observed",
              "uncertainty",
              "source_record_id",
              "source_kind",
              "status"
            ],
            "properties": {
              "test_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "test_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "configuration": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "product",
                  "revision"
                ],
                "properties": {
                  "product": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "measurand": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "observed": {
                "type": "number",
                "minimum": -1000000000000,
                "maximum": 1000000000000
              },
              "uncertainty": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "source_record_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source_kind": {
                "enum": [
                  "SYNTHETIC",
                  "SUPPLIED_UNVERIFIED"
                ]
              },
              "status": {
                "enum": [
                  "COMPLETE",
                  "FAILED"
                ]
              }
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "requirement_revision",
          "test_id",
          "test_revision",
          "result_id",
          "result_sha256"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "requirement_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "test_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "test_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "result_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "result_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
