{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "product_index": {
      "type": "integer"
    },
    "transducer": {
      "type": "string"
    },
    "lifecycle": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "maxItems": 262144,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "minimum",
          "maximum",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 262144,
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          }
        },
        "required": [
          "requirement_id",
          "value",
          "unit",
          "evidence_ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "product_index",
    "transducer",
    "lifecycle",
    "risk",
    "objective",
    "requirements",
    "observations"
  ],
  "additionalProperties": false
}
