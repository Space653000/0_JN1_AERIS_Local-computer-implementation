{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "head_radius_m",
    "sound_speed_m_s",
    "azimuth_deg",
    "claimed_itd_us",
    "max_acceptable_itd_error_us"
  ],
  "properties": {
    "head_radius_m": {"type": "number", "minimum": 0.06, "maximum": 0.11},
    "sound_speed_m_s": {"type": "number", "minimum": 300, "maximum": 360},
    "azimuth_deg": {"type": "number", "minimum": -180, "maximum": 180},
    "claimed_itd_us": {"type": "number", "minimum": -1000, "maximum": 1000},
    "max_acceptable_itd_error_us": {"type": "number", "exclusiveMinimum": 0, "maximum": 500}
  }
}
