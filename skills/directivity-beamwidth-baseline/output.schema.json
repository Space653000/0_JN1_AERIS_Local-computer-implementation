        "disposition", "required_revisions", "counter_hypotheses", "next_discriminating_experiment",
        "model_assumptions", "unresolved"
      ],
      "properties": {
        "negative_crossing_deg": {"type": "number"},
        "positive_crossing_deg": {"type": "number"},
        "beamwidth_deg": {"type": "number"},
        "within_target": {"type": "boolean"},
        "checks": {"type": "array"},
        "disposition": {"type": "string"},
        "required_revisions": {"type": "array"},
        "counter_hypotheses": {"type": "array"},
        "next_discriminating_experiment": {"type": "string"},
        "model_assumptions": {"type": "array"},
