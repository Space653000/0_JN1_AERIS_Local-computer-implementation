{
  "suite_id": "R063-AUTOMOTIVE-CABIN-TUNING-SCREEN-V1", "role_id": "R063", "skill_id": "automotive-cabin-tuning-screening-baseline", "source_kind": "SYNTHETIC",
  "oracle_provenance": "Exact absolute-difference and boolean comparison against declared scalars; no physical vehicle cabin was observed.",
  "scope": "Supplied driver/rear seat levels, declared acceptable spread and road-noise-validation flag only",
