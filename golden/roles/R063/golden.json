  "cases": [
    {"id": "AUTO-SEAT-BALANCE-AND-ROAD-VALIDATED-ACCEPT", "kind": "positive", "question": "Does a small driver/rear seat spread with road-noise validation clear the screen?", "input_overrides": {}, "checks": [
      {"path": "seat_level_spread_db", "expected": 3.0, "absolute_tolerance": 1e-9},
