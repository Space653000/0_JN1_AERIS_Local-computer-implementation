    {"id": "RESULT-HIDDEN-RETRY-REJECTED", "kind": "counter_hypothesis", "question": "Is the identical eventual pass correctly rejected when the same retries are not disclosed?", "input_overrides": {"retries_disclosed": false}, "checks": [
