      {"path": "disposition", "expected": "DESIGN_REVISION_REQUIRED", "absolute_tolerance": 0}
    ]},
    {"id": "RESULT-SINGLE-ATTEMPT-NO-EXPLICIT-SIGNAL-BOUNDARY", "kind": "boundary", "question": "Does a single attempt correctly make retry-disclosure moot, while still catching a missing explicit pass signal (process-alive-as-pass)?", "input_overrides": {"attempt_count": 1, "retries_disclosed": false, "explicit_pass_signal_received": false}, "checks": [
      {"path": "checks.0.passed", "expected": true, "absolute_tolerance": 0},
      {"path": "checks.1.passed", "expected": false, "absolute_tolerance": 0},
      {"path": "disposition", "expected": "DESIGN_REVISION_REQUIRED", "absolute_tolerance": 0}
    ]},
    {"id": "RESULT-ZERO-ATTEMPT-COUNT-REJECTED", "kind": "negative", "question": "Is a non-positive attempt count rejected rather than silently treated as a trivial single attempt?", "input_overrides": {"attempt_count": 0}, "expected_error": "ValueError"}
  ]
