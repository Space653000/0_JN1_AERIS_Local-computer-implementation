      {"path": "required_revisions.1", "expected": "IMPROVE_ACTUATOR_ACOUSTIC_ISOLATION_OR_GATE_VAD_DURING_TRACKING_MOTION_OR_RELAX_THE_MARGIN_TARGET", "absolute_tolerance": 0},
