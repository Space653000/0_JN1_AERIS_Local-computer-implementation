    {"id": "PATENT-NO-NOVELTY-VERDICT-CLAIMED-BOUNDARY", "kind": "boundary", "question": "Does a comparison with no novelty verdict claimed correctly clear via short-circuit, rather than requiring mapping it never claimed?", "input_overrides": {"novelty_verdict_claimed": false, "claim_element_mapping_performed": false}, "checks": [
