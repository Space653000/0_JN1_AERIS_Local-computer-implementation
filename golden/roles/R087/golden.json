    {"id": "PATENT-UNKNOWN-DATE-TYPE-REJECTED", "kind": "negative", "question": "Is an unrecognized date type rejected rather than silently accepted?", "input_overrides": {"date_type_used": "FILING_DATE"}, "expected_error": "ValueError"}
  ]
