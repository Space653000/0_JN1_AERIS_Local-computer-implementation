    {"id": "PATENT-KEYWORD-ONLY-AND-PUBLICATION-DATE-BOTH-REJECTED", "kind": "counter_hypothesis", "question": "Are a keyword-only novelty verdict and a publication-date comparison both correctly rejected together, rather than one masking the other?", "input_overrides": {"claim_element_mapping_performed": false, "date_type_used": "PUBLICATION_DATE"}, "checks": [
      {"path": "checks.0.passed", "expected": false, "absolute_tolerance": 0},
