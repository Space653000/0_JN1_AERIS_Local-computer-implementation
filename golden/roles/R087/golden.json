{
  "suite_id": "R087-PATENT-PRIOR-ART-SCREEN-V1", "role_id": "R087", "skill_id": "patent-prior-art-screening-baseline", "source_kind": "SYNTHETIC",
  "oracle_provenance": "Exact boolean-logic and equality comparison against declared scalars; no physical/legal patent examination was observed.",
