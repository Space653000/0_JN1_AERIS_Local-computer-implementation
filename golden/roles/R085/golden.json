      {"path": "required_revisions.1", "expected": "REMOVE_DUPLICATE_SOURCE_RECORDINGS_FROM_OVERLAPPING_SPLITS_AND_RE_PARTITION", "absolute_tolerance": 0},
      {"path": "disposition", "expected": "DESIGN_REVISION_REQUIRED", "absolute_tolerance": 0}
    ]},
    {"id": "DATA-MIXED-RATES-BUT-EXPLICITLY-RESAMPLED-BOUNDARY", "kind": "boundary", "question": "Does an explicitly resampled mixed-rate dataset correctly clear via the resampling branch, rather than mixed rates alone being an automatic rejection?", "input_overrides": {"sample_rates_uniform": false, "resampling_applied_before_combining": true}, "checks": [
