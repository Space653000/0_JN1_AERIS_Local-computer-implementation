    ]},
    {"id": "DATA-NEGATIVE-DUPLICATE-COUNT-REJECTED", "kind": "negative", "question": "Is a negative duplicate-source count rejected rather than silently accepted?", "input_overrides": {"duplicate_source_count_across_splits": -1}, "expected_error": "ValueError"}
  ]
