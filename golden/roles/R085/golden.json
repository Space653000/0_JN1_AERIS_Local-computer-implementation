    {"id": "DATA-MIXED-RATES-AND-DUPLICATE-SOURCES-BOTH-REJECTED", "kind": "counter_hypothesis", "question": "Are mixed unresampled sample rates and duplicate cross-split sources both correctly rejected together, rather than one masking the other?", "input_overrides": {"sample_rates_uniform": false, "duplicate_source_count_across_splits": 5}, "checks": [
      {"path": "checks.0.passed", "expected": false, "absolute_tolerance": 0},
