{
  "suite_id": "R033-REFERENCE-NOISE-HEADROOM-V1",
  "role_id": "R033",
  "skill_id": "microphone-reference-noise-headroom-baseline",
  "source_kind": "SYNTHETIC",
  "oracle_provenance": "Manually worked 1 Pa / 0.1 V / gain 10 reference; 6-8-10 microvolt noise triangle; 100 dB SPL = 2 Pa; independent boundary and causal-discrimination scenarios. No claimed acquired measurement.",
