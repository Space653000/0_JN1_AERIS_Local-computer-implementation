    "signal_crest_factor": 2,
    "minimum_sensitivity_dbv_per_pa": -42,
    "maximum_sensitivity_dbv_per_pa": -38,
    "maximum_self_noise_spl_db": 20,
    "minimum_electrical_headroom_db": 3,
    "pressure_relative_bound": 0,
    "gain_relative_bound": 0,
    "noise_relative_bound": 0
  },
  "cases": [
